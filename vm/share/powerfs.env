# =============================================================================
# PowerFS 统一地址 / 集群配置 (single source of truth)
# -----------------------------------------------------------------------------
# 宿主机脚本 (qemuctl.sh / qemuctl2.sh / run_qemu*.sh / run-vm.sh /
# build_initramfs.sh / setup_network*.sh) 与 VM 内挂载辅助
# (/mnt/host/powerfs-mount.sh) 都 source 本文件.
# 改 Master 地址 / 端口 / 证书 / 传输方式只改这里, 不要在各脚本或 mount
# 命令里再硬编码, 以免 "地址老是用错".
#
# 物理位置: 宿主机 kernel/vm/share/powerfs.env  (9p 共享目录)
#           -> VM 内 /mnt/host/powerfs.env
#
# 所有变量均可用同名环境变量覆盖, 例如:
#   POWERFS_MASTER_ADDR=1.2.3.4 ./qemuctl2.sh start
#
# 语法为 POSIX sh (busybox ash 兼容), VM 内也能直接 source.
# =============================================================================

# --- from-cluster 自动覆盖 ----------------------------------------------------
# 如果仓库根目录同时存在 cluster.toml + rendered/docker-compose.yml (powerfs-ctl
# bootstrap 产物), 自动从单源解析并覆盖下方 := 默认值.
# 宿主机脚本 source 本文件时, 会沿 share/powerfs.env → 上溯到 .powerfs/ 找
# cluster.toml (兼容 cwd 不在仓库根的场景).
# 用户显式 export 的同名环境变量不会被覆盖 (source 顺序: 用户 env → powerfs.env
# : 默认值 → from-cluster 自动覆盖).
# -----------------------------------------------------------------------------
# 定位本文件所在目录 (POSIX sh 兼容: busybox ash 无 BASH_SOURCE)
_PF_ENV_SELF="${BASH_SOURCE:-$0}"
_PF_ENV_DIR="$(cd "$(dirname "$_PF_ENV_SELF")" 2>/dev/null && pwd)" || _PF_ENV_DIR="$PWD"
_PF_CLUSTER_TOML=""
_PF_RENDERED_COMPOSE=""
# 从本文件目录逐级上溯找仓库根 (含 .powerfs/cluster.toml + rendered compose)
_PF_PROBE="$_PF_ENV_DIR"
while [ -n "$_PF_PROBE" ] && [ "$_PF_PROBE" != "/" ]; do
    _PF_T="$_PF_PROBE/.powerfs/cluster.toml"
    _PF_R="$_PF_PROBE/.powerfs/rendered/docker-compose.yml"
    if [ -f "$_PF_T" ] && [ -f "$_PF_R" ]; then
        _PF_CLUSTER_TOML="$_PF_T"
        _PF_RENDERED_COMPOSE="$_PF_R"
        break
    fi
    _PF_PROBE="$(dirname "$_PF_PROBE")"
done
unset _PF_PROBE _PF_T _PF_R _PF_ENV_SELF

if [ -n "$_PF_CLUSTER_TOML" ] && [ -n "$_PF_RENDERED_COMPOSE" ]; then
    # 解析 rendered compose 中的服务 IP (同 generate-certs.sh 的 awk)
    _PF_MASTER_IPS=""
    _PF_FILER_IPS=""
    _PF_VOLUME_IPS=""
    while IFS='=' read -r _PF_ROLE _PF_IP; do
        case "$_PF_ROLE" in
            master-*) _PF_MASTER_IPS="$_PF_MASTER_IPS${_PF_MASTER_IPS:+,}$_PF_IP" ;;
            filer-*)  _PF_FILER_IPS="${_PF_FILER_IPS}${_PF_FILER_IPS:+ }$_PF_IP" ;;
            volume-*) _PF_VOLUME_IPS="${_PF_VOLUME_IPS}${_PF_VOLUME_IPS:+ }$_PF_IP" ;;
        esac
    done <<_PF_EOF
$(awk '
        /^  [a-z]+-[0-9]+:[[:space:]]*$/ {
            role = $0; sub(/^  /, "", role); sub(/:[[:space:]]*$/, "", role); found_ip = 0; next
        }
        role != "" && found_ip == 0 && /ipv4_address:/ {
            ip = $0; sub(/.*ipv4_address:[[:space:]]*/, "", ip); gsub(/[[:space:]]/, "", ip); found_ip = 1
            print role "=" ip
        }
    ' "$_PF_RENDERED_COMPOSE")
_PF_EOF

    # 从 cluster.toml 取 [cluster] / [network] 段
    _PF_SUBNET=$(sed -n 's/^[[:space:]]*subnet[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_PF_CLUSTER_TOML" | head -1)
    _PF_GATEWAY=$(sed -n 's/^[[:space:]]*gateway[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$_PF_CLUSTER_TOML" | head -1)
    _PF_SHARD_COUNT=$(sed -n 's/^[[:space:]]*shard_count[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$_PF_CLUSTER_TOML" | head -1)

    # 仅在变量未被用户显式设置时才用 from-cluster 覆盖
    [ -z "${POWERFS_MASTER_ADDR+set}" ] && [ -n "$_PF_MASTER_IPS" ] && POWERFS_MASTER_ADDR="$_PF_MASTER_IPS"
    [ -z "${POWERFS_FILER_ADDR+set}" ] && [ -n "$_PF_FILER_IPS" ]  && POWERFS_FILER_ADDR="$_PF_FILER_IPS"
    [ -z "${POWERFS_VOLUME_ADDR+set}" ] && [ -n "$_PF_VOLUME_IPS" ] && POWERFS_VOLUME_ADDR="$_PF_VOLUME_IPS"
    [ -z "${POWERFS_GATEWAY+set}" ] && [ -n "$_PF_GATEWAY" ]       && POWERFS_GATEWAY="$_PF_GATEWAY"
    [ -z "${POWERFS_SUBNET+set}" ] && [ -n "$_PF_SUBNET" ]         && POWERFS_SUBNET="$_PF_SUBNET"
    [ -z "${POWERFS_SHARD_COUNT+set}" ] && [ -n "$_PF_SHARD_COUNT" ] && POWERFS_SHARD_COUNT="$_PF_SHARD_COUNT"
fi
unset _PF_ENV_DIR _PF_CLUSTER_TOML _PF_RENDERED_COMPOSE _PF_MASTER_IPS _PF_FILER_IPS _PF_VOLUME_IPS
unset _PF_ROLE _PF_IP _PF_SUBNET _PF_GATEWAY _PF_SHARD_COUNT

# --- Master 后端服务地址 -----------------------------------------------------
# 默认 host RDMA 拓扑 (VM 原生场景, 宿主机 master=192.168.100.3).
# docker HA 集群场景会被上面的 from-cluster 块自动覆盖为 172.30.0.11,12,13.
: "${POWERFS_MASTER_ADDR:=192.168.100.3}"
# 首个 master (单主机语义: admin API / ping / SSH; HA 逗号列表取第一项)
: "${POWERFS_MASTER_PRIMARY:=${POWERFS_MASTER_ADDR%%,*}}"
: "${POWERFS_MASTER_PORT:=9334}"
: "${POWERFS_API_PORT:=9300}"       # REST API 端口 (admin / bootstrap)

# --- Filer / Volume 地址 (补充自 cluster.toml 或 fallback 默认) -------------
# 默认值: host RDMA 单 filer + RDMA volume 拓扑.
# docker HA 集群场景会被 from-cluster 覆盖.
: "${POWERFS_FILER_PORT:=9334}"
: "${POWERFS_VOLUME_PORT:=8901}"
: "${POWERFS_FILER_ADDR:=172.30.0.31 172.30.0.32 172.30.0.33}"
: "${POWERFS_VOLUME_ADDR:=172.30.0.21 172.30.0.22 172.30.0.23}"

# shard_count = Master Raft 节点数: 单节点=1, 三节点=3
: "${POWERFS_SHARD_COUNT:=1}"

# 传输方式: rdma (默认, 走 IB) 或 tcp
: "${POWERFS_TRANSPORT:=rdma}"

# --- VM / Docker 网络 --------------------------------------------------------
: "${POWERFS_SUBNET:=172.30.0.0/16}"
# gateway / VM eth0 IP 跟随 SUBNET 派生（与 powerfs-ctl render 的
# auto-derive 语义一致：gateway = subnet 首地址，VM = subnet 前两段 + .100/.101）。
# 用户显式 export 时优先（${VAR+set} guard 在 from-cluster 块之上不拦截这里，
# 故此处仅在变量完全未设置时派生）。
_PF_SN_PREFIX=${POWERFS_SUBNET%/*}        # 172.31.0.0
_PF_SN_AB=${_PF_SN_PREFIX%.*.*}           # 172.31
if [ -z "${POWERFS_GATEWAY+set}" ]; then
    POWERFS_GATEWAY="${_PF_SN_AB}.0.1"
fi
if [ -z "${VM1_ETH0_IP+set}" ]; then
    VM1_ETH0_IP="${_PF_SN_AB}.0.100"
fi
if [ -z "${VM2_ETH0_IP+set}" ]; then
    VM2_ETH0_IP="${_PF_SN_AB}.0.101"
fi
unset _PF_SN_PREFIX _PF_SN_AB

# --- 证书 (VM 内路径) --------------------------------------------------------
: "${POWERFS_CERT_DIR:=/etc/powerfs}"
: "${POWERFS_CA_CRT:=/etc/powerfs/ca.crt}"
: "${POWERFS_CLIENT_CRT:=/etc/powerfs/kernel-client-1.crt}"
: "${POWERFS_CLIENT_KEY:=/etc/powerfs/kernel-client-1.key}"

# --- 挂载点 ------------------------------------------------------------------
: "${POWERFS_MOUNT_POINT:=/mnt/powerfs}"

# --- VM SSH 端口 (宿主机访问 VM) ---------------------------------------------
: "${VM1_SSH_PORT:=2223}"
: "${VM2_SSH_PORT:=2224}"
